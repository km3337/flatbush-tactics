[resource]
script = ExtResource("6_hwlj6")
id = &"churro_lady"
title = "Churro Lady"
text = "At the top of the stairs, a woman with a shopping cart full of churros calls out: \"Churros! One dollar, one dollar!\"

They smell incredible. Her cart is suspiciously full for this late."
choices = Array[ExtResource("1_hd07s")]([SubResource("Resource_tgw4k"), SubResource("Resource_bvpdd"), SubResource("Resource_hcug6")])
