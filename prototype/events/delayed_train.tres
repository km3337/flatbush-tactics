[resource]
script = ExtResource("6_4hjmo")
id = &"delayed_train"
title = "Train Traffic Ahead"
text = "The train lurches to a stop between stations.

\"We are delayed because of train traffic ahead. We apologize for the inconvenience.\"

The car goes quiet. The emergency door at the end isn't locked. You could probably walk the tracks to the next platform."
choices = Array[ExtResource("1_nj0kn")]([SubResource("Resource_i8itw"), SubResource("Resource_jlohx")])
