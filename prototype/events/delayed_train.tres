[sub_resource type="Resource" id="Resource_inl6w"]
script = ExtResource("2_artt8")
weight = 3.0
text = "Something glints between the rails: a fat roll of cash someone dropped."
effects = Array[ExtResource("3_pyrmb")]([SubResource("Resource_7v4s8")])

[sub_resource type="Resource" id="Resource_q6h8a"]
script = ExtResource("4_ddiov")

[sub_resource type="Resource" id="Resource_npdo5"]
