[gd_resource type="Resource" script_class="FTEvent" format=3]

[ext_resource type="Script" path="res://scripts/events/event_choice.gd" id="1_0vf67"]
[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="2_1253c"]
[ext_resource type="Script" path="res://scripts/events/event_effect.gd" id="3_uuft8"]
[ext_resource type="Script" path="res://scripts/events/effects/money_effect.gd" id="4_61a3u"]
[ext_resource type="Script" path="res://scripts/events/effects/ambush_effect.gd" id="5_y764p"]
[ext_resource type="Script" path="res://scripts/events/effects/round_effect.gd" id="6_r2s23"]
[ext_resource type="Script" path="res://scripts/events/event.gd" id="7_o32u8"]

[sub_resource type="Resource" id="Resource_l2hi0"]
script = ExtResource("4_61a3u")
amount = Vector2i(10, 20)

[sub_resource type="Resource" id="Resource_3ii4i"]
script = ExtResource("2_1253c")
weight = 3.0
text = "You swipe it at the next turnstile: still loaded. You cash out the balance."
effects = Array[ExtResource("3_uuft8")]([SubResource("Resource_l2hi0")])

[sub_resource type="Resource" id="Resource_ws17p"]
script = ExtResource("5_y764p")

[sub_resource type="Resource" id="Resource_h0n5v"]
script = ExtResource("2_1253c")
weight = 2.0
text = "Empty. And the man saw you take it. He follows you onto the train, talking into his phone."
effects = Array[ExtResource("3_uuft8")]([SubResource("Resource_ws17p")])

[sub_resource type="Resource" id="Resource_s7qhi"]
script = ExtResource("1_0vf67")
label = "Pocket it"
outcomes = Array[ExtResource("2_1253c")]([SubResource("Resource_3ii4i"), SubResource("Resource_h0n5v")])

[sub_resource type="Resource" id="Resource_6w8xm"]
script = ExtResource("2_1253c")
weight = 3.0
text = "He nearly hugs you. \"Bless you.\" It's a nice feeling, at least."

[sub_resource type="Resource" id="Resource_km8ir"]
script = ExtResource("6_r2s23")

[sub_resource type="Resource" id="Resource_ru5c5"]
script = ExtResource("2_1253c")
weight = 2.0
text = "\"Hold on, take this.\" He presses something into your hand: a round, wrapped in a receipt."
effects = Array[ExtResource("3_uuft8")]([SubResource("Resource_km8ir")])

[sub_resource type="Resource" id="Resource_ccspn"]
script = ExtResource("1_0vf67")
label = "Give it back"
outcomes = Array[ExtResource("2_1253c")]([SubResource("Resource_6w8xm"), SubResource("Resource_ru5c5")])

[resource]
script = ExtResource("7_o32u8")
id = &"lost_metrocard"
title = "Lost MetroCard"
text = "A MetroCard sits on the platform, half under a bench. A few feet away, a man pats down every pocket he has, getting more desperate by the second."
choices = Array[ExtResource("1_0vf67")]([SubResource("Resource_s7qhi"), SubResource("Resource_ccspn")])
